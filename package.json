{
  "name": "sprea-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "deploy:pages": "npm run build && npm run verify:production-build && wrangler pages deploy out --project-name sprea-frontend",
    "test": "node --experimental-transform-types --test tests/*.test.mjs",
    "verify:production-build": "node scripts/verify-production-build.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-server-dom-webpack": "^19.2.8",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.3",
    "typescript": "^5",
    "wrangler": "^4.127.0"
  },
  "type": "module"
}
